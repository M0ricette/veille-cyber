# Copier ce fichier en .env puis remplir. Ne jamais commiter .env.

ANTHROPIC_API_KEY=sk-ant-...
# Modèle léger par défaut. Pour une une mieux écrite : claude-sonnet-5-5
LLM_MODEL=claude-haiku-4-5-20251001

# Limites de l'agent
AGENT_MAX_TOURS=10
AGENT_MAX_LECTURES=6

# Journal
NOM_JOURNAL=Le Veilleur
PREMIER_NUMERO=2026-10-07
WINDOW_HOURS=24

# Gmail : créer un mot de passe d'application, le mot de passe du compte ne marche pas.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ton.adresse@gmail.com
SMTP_PASSWORD=mot-de-passe-application
MAIL_TO=ton.adresse@gmail.com
